# API Service Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Atlas Database
# Note: @ symbol in password is URL-encoded as %40
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/code-runner?retryWrites=true&w=majority

# Redis Configuration
# For VPS production: use localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# For external Redis (development only):
# REDIS_URL=redis://default:PASSWORD@HOST:PORT

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Admin Dashboard — Nginx Metrics (VPS only)
# Path to Nginx access log. Auto-detected on VPS.
# NGINX_LOG_PATH=/var/log/nginx/code-runner-access.log

# Admin Dashboard — Railway Metrics (optional)
# Get token from: Railway Dashboard → Account Settings → Tokens
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=

# ADMIN-LINK Hub SSO (optional)
# Lets the ADMIN-LINK hub log into this module's admin dashboard via iframe with
# no second login. Leave all three unset to disable (the SSO endpoint then returns
# 503 and the frontend just shows the normal login). All three are required together.
#   HUB_SSO_SECRET   — shared secret, SAME value the hub holds. Min 32 chars.
#                      Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   HUB_SSO_AUDIENCE — this module's id in the hub registry; must equal the token's
#                      `aud` claim byte-for-byte (e.g. code-runner).
#   HUB_SSO_USERNAME — the account a hub login maps to (defaults to "owner").
# HUB_SSO_SECRET=
# HUB_SSO_AUDIENCE=
# HUB_SSO_USERNAME=owner
