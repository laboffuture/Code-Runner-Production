# Runner Service Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Environment
NODE_ENV=development

# MongoDB Atlas Database
# Must match the same database as API service
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/code-runner?retryWrites=true&w=majority

# Redis Configuration
# For VPS production: use localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# For external Redis (development only):
# REDIS_URL=redis://default:PASSWORD@HOST:PORT

# JWT Configuration (must match API service)
JWT_SECRET=

# Worker Configuration
WORKER_CONCURRENCY_EXECUTION=5
WORKER_CONCURRENCY_SUBMISSION=3

# Container Pooling Configuration
ENABLE_CONTAINER_POOL=true
POOL_MIN_SIZE=2
POOL_MAX_SIZE=5
POOL_MAX_CONTAINER_AGE_MS=1800000

# Docker sandbox image name
SANDBOX_IMAGE=python-code-runner
