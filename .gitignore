# ============================================================
# Root .gitignore for Coderunner monorepo (backend + frontend)
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
dist/
**/dist/
build/
out/
.next/
**/.next/
*.tsbuildinfo

# Environment variables — NEVER commit real secrets
# (.env.local / .env hold live credentials; only *.example files are committed)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production
.env.production.local
**/.env
**/.env.local
**/.env.*.local
**/.env.production

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing / coverage
coverage/

# Secrets / keys
*.pem
*.key

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
nul

# Caches
.cache/

# Claude temporary files
tmpclaude*
**/tmpclaude*

# Package locks in subfolders (keep only root locks)
apps/*/package-lock.json
packages/*/package-lock.json
