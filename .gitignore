# ============================================================
# Root .gitignore for Coderunner monorepo (backend + frontend)
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
dist/
**/dist/
build/
out/
.next/
**/.next/
*.tsbuildinfo

# Stray compiled TypeScript output emitted BESIDE source (real build output
# only ever lives in dist/). A `tsc`/`tsc -b` run without the right outDir can
# litter src/ with these; they must never be committed. src/ trees are pure TS,
# and *.map/*.d.ts are never hand-written, so these patterns can't hide source.
*.js.map
*.d.ts.map
**/src/**/*.js
**/src/**/*.d.ts

# Environment variables — NEVER commit real secrets
# (.env.local / .env hold live credentials; only *.example files are committed)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production
.env.production.local
**/.env
**/.env.local
**/.env.*.local
**/.env.production

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing / coverage
coverage/

# Secrets / keys
*.pem
*.key

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
nul

# Caches
.cache/

# Claude temporary files
tmpclaude*
**/tmpclaude*

# Package locks in subfolders (keep only root locks)
apps/*/package-lock.json
packages/*/package-lock.json

# Local-only operational files — NEVER push (student credentials, scratch backups)
# Credential sheets handed to schools stay on the operator's machine only.
*-student-logins.csv
*-student-logins.html
cmis-student-logins.csv
cmis-student-logins.html
scripts/_*-backup/
